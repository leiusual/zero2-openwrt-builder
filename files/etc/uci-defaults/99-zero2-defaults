#!/bin/sh
# OpenWrt runs this after config_generate and wifi config, before networking.
# Successful scripts are removed; failures are retried at the next boot.
. /lib/functions.sh
. /lib/functions/system.sh

[ "$(board_name)" = 'friendlyarm,nanopi-zero2' ] || exit 0
# Preserve user settings on subsequent upgrades that retain configuration.
[ "$(uci -q get 'system.@system[0].zero2_defaults_version')" = '1' ] && exit 0

find_lan_bridge() {
	local name
	config_get name "$1" name
	[ "$name" != 'br-lan' ] || lan_bridge="$1"
}

configure_radio() {
	uci set "wireless.$1.band=5g" || failed=1
	uci set "wireless.$1.country=CN" || failed=1
	uci set "wireless.$1.disabled=0" || failed=1
	radios=$((radios + 1))
}

configure_ap() {
	local mode
	config_get mode "$1" mode
	[ "$mode" = 'ap' ] || return 0
	uci set "wireless.$1.network=lan" || failed=1
	uci set "wireless.$1.ssid=Zero" || failed=1
	uci set "wireless.$1.encryption=none" || failed=1
	uci set "wireless.$1.disabled=0" || failed=1
	aps=$((aps + 1))
}

# Keep radio path, channel and width from official hardware detection.
/sbin/wifi config
radios=0
aps=0
failed=0
config_load wireless
config_foreach configure_radio wifi-device
config_foreach configure_ap wifi-iface
if [ "$radios" -eq 0 ] || [ "$aps" -eq 0 ] || [ "$failed" -ne 0 ]; then
	echo 'Zero2: wireless defaults incomplete; retrying on next boot' >&2
	exit 1
fi

# Board detection assigns eth0 to WAN. Create LAN as an empty Wi-Fi bridge.
lan_bridge=br_lan
config_load network
config_foreach find_lan_bridge device
uci set "network.$lan_bridge=device" || exit 1
uci set "network.$lan_bridge.name=br-lan" || exit 1
uci set "network.$lan_bridge.type=bridge" || exit 1
uci -q delete "network.$lan_bridge.ports"
uci set "network.$lan_bridge.bridge_empty=1" || exit 1
uci set network.lan='interface' || exit 1
uci set network.lan.device='br-lan' || exit 1
uci set network.lan.proto='static' || exit 1
uci set network.lan.ipaddr='192.168.2.1/24' || exit 1
uci set network.lan.ip6assign='60' || exit 1
# Empty hostname would fall back to the system hostname in netifd.
uci set network.wan.hostname='*' || exit 1
uci set network.wan6.noclientfqdn='1' || exit 1
uci set 'system.@system[0].hostname=Zero' || exit 1
uci set 'system.@system[0].zonename=Asia/Singapore' || exit 1
uci set 'system.@system[0].timezone=<+08>-8' || exit 1

uci commit network || exit 1
uci commit wireless || exit 1
uci set 'system.@system[0].zero2_defaults_version=1' || exit 1
uci commit system || exit 1
exit 0
