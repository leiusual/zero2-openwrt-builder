#!/bin/sh
# Fixed first-boot settings, following the OpenWrt Firmware Selector template.
exec >/tmp/zero2-setup.log 2>&1

# System
uci set 'system.@system[0].hostname=Zero' || exit 1
uci set 'system.@system[0].zonename=Asia/Singapore' || exit 1
uci set 'system.@system[0].timezone=<+08>-8' || exit 1
uci commit system || exit 1

# LAN: an empty bridge for Wi-Fi, with no Ethernet ports.
uci set network.br_lan='device' || exit 1
uci set network.br_lan.name='br-lan' || exit 1
uci set network.br_lan.type='bridge' || exit 1
uci -q delete network.br_lan.ports || true
uci set network.br_lan.bridge_empty='1' || exit 1
uci set network.lan='interface' || exit 1
uci set network.lan.device='br-lan' || exit 1
uci set network.lan.proto='static' || exit 1
uci set network.lan.ipaddr='192.168.2.1/24' || exit 1
uci -q delete network.lan.netmask || true
uci set network.lan.ip6assign='60' || exit 1

# WAN: eth0 uses DHCP, without sending a hostname or client FQDN.
uci set network.wan='interface' || exit 1
uci set network.wan.device='eth0' || exit 1
uci set network.wan.proto='dhcp' || exit 1
uci set network.wan.hostname='*' || exit 1
uci set network.wan6='interface' || exit 1
uci set network.wan6.device='eth0' || exit 1
uci set network.wan6.proto='dhcpv6' || exit 1
uci set network.wan6.noclientfqdn='1' || exit 1
uci commit network || exit 1

# Wi-Fi: modify the sections generated by OpenWrt; leave channel/path/width alone.
uci set 'wireless.@wifi-device[0].band=5g' || exit 1
uci set 'wireless.@wifi-device[0].country=CN' || exit 1
uci set 'wireless.@wifi-device[0].disabled=0' || exit 1
uci set 'wireless.@wifi-iface[0].mode=ap' || exit 1
uci set 'wireless.@wifi-iface[0].network=lan' || exit 1
uci set 'wireless.@wifi-iface[0].ssid=Zero' || exit 1
uci set 'wireless.@wifi-iface[0].encryption=none' || exit 1
uci -q delete 'wireless.@wifi-iface[0].key' || true
uci set 'wireless.@wifi-iface[0].disabled=0' || exit 1
uci commit wireless || exit 1

echo 'All done!'
exit 0
